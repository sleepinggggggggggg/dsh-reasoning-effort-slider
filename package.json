{
  "name": "dsh-reasoning-effort-slider",
  "version": "0.2.4",
  "description": "Codex-style reasoning-effort slider for DeepSeek Harness: turns the model menu's Effort row into a continuous, level-snapping slider.",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "meta": {
    "title": "Reasoning Effort Slider",
    "description": "Turns the model menu Effort row into a Codex-style slider: a white knob that follows the pointer, blue-to-violet fill, starfield at high levels, and a tinted effort label."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sleepinggggggggggg/dsh-reasoning-effort-slider.git"
  },
  "homepage": "https://github.com/sleepinggggggggggg/dsh-reasoning-effort-slider#readme",
  "bugs": {
    "url": "https://github.com/sleepinggggggggggg/dsh-reasoning-effort-slider/issues"
  }
}
