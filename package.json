{
  "name": "dsh-reasoning-effort-slider",
  "version": "0.2.1",
  "description": "把 DSH 官方模型菜单里的「推理等级」变成一条 Codex 风格推理强度滑条。",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "meta": {
    "title": "推理强度滑条",
    "description": "把官方模型菜单里的「推理等级」变成一条 Codex 风格滑条：按档吸附的白色圆钮、蓝紫渐变、高档星尘，档位名与取值随主题高亮。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sleepinggggggggggg/dsh-reasoning-effort-slider.git"
  },
  "homepage": "https://github.com/sleepinggggggggggg/dsh-reasoning-effort-slider#readme",
  "bugs": {
    "url": "https://github.com/sleepinggggggggggg/dsh-reasoning-effort-slider/issues"
  }
}
